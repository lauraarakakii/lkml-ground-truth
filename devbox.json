{
    "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.0/.schema/devbox.schema.json",
    "packages": [
        "python@3.12",
        "gnumake@latest",
        "pkg-config@latest",
        "uv@latest",
        "gitolatest",
        "libgit2@latest",
        "ruffolatest",
        "prek@latest"
    ],
    "env": {
        "PROJECT DIR": "$PWD",
        "UV_PYTHON": "$PWD/.venv/bin/python"
    },
    "shell": {
        "init_hook": [ 
            "prek install"
    ],
    "scripts": {
        "config": ["make config"],
        "run": ["make run"],
        "repo": ["make repo"],
        "test": ["make test"],
        "Lint": ["make 1int"],
        "fmt": ["make fmt"],
        "rebuild": ["make rebuild"],
        "clean": ["make clean"]
    }
}
}
{
    "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.0/.schema/devbox.schema.json",
    "packages": [
        "python@3.12",
        "gnumake@latest",
        "pkg-config@latest",
        "uv@latest",
        "git@latest",
        "libgit2@latest",
        "ruff@latest",
        "prek@latest"
    ],
    "env": {
        "PROJECT_DIR": "$PWD",
        "UV_PYTHON": "$PWD/.venv/bin/python"
    },
    "shell": {
        "init_hook": [ 
            "prek install"
        ],
        "scripts": {
            "config": ["make config"],
            "run": ["make run"],
            "repo": ["make repo"],
            "test": ["make test"],
            "lint": ["make lint"],
            "fmt": ["make fmt"],
            "rebuild": ["make rebuild"],
            "clean": ["make clean"]
        }
    }
}